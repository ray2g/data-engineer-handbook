# ═══════════════════════════════════════════════════════════════════
# .env.example — Environment Variables for the Training Pipeline
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file to source control.
#
# Required when running locally OR submitting a Dataproc Batch job.
# These variables are picked up automatically by the pipeline.
# ───────────────────────────────────────────────────────────────────

# ── Google Cloud ──────────────────────────────────────────────
# Path to the GCP service account key JSON (local only).
# On Dataproc Batch the default service account is used instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# GCP project used for Dataproc, BigQuery and GCS.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1

# ── MLflow Tracking ───────────────────────────────────────────
MLFLOW_TRACKING_URI=https://your-mlflow-server/mlflow
MLFLOW_TRACKING_USERNAME=your-mlflow-username
MLFLOW_TRACKING_PASSWORD=your-mlflow-password

# ── BigQuery / Data Source ────────────────────────────────────
BQ_DATASET=your_dataset
BQ_LOCATION=EU

# ── Docker Registry ───────────────────────────────────────────
# Artifact Registry repository used to push the training Docker image.
DOCKER_REGISTRY=europe-docker.pkg.dev/your-gcp-project-id/your-repo

# ── Dataproc Staging ──────────────────────────────────────────
DATAPROC_STAGING_BUCKET=gs://your-bucket/dataproc-staging
